# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
# package-lock.json IS committed — the Dockerfile uses `npm ci`, which requires
# a locked, reproducible dependency tree to be present in the build context.

# testing
/coverage

# production
/build

# misc
.DS_Store

# env files — never commit real secrets (copy .env.example -> .env)
.env
.env.development
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
