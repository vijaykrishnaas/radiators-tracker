# Copy to .env on the EC2 instance and fill in real values. Never commit .env.

# Domain the API is served on (DNS A-record -> this instance's public IP).
# A free DuckDNS subdomain works: e.g. radiator-api.duckdns.org
API_DOMAIN=api.example.com

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Create the M0 cluster in the SAME region as this EC2 instance.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

PORT=5000

# Long random secret for JWT signing — generate with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=12h

# Super-admin seeded on first boot (change the password after first login).
SUPERADMIN_USER_ID=superadmin
SUPERADMIN_PASSWORD=CHANGE_ME
SUPERADMIN_NAME=Super Admin

# Lock the API down to your Netlify site (comma-separated if several).
ALLOWED_ORIGINS=https://your-site.netlify.app
